# ---------------------------------------------------------------------------
# Bot de surveillance de stock — configuration
# Copie ce fichier vers .env puis renseigne au minimum STOCKWATCH_BOT_TOKEN.
# ---------------------------------------------------------------------------

# --- Telegram (obligatoire) ------------------------------------------------
# Token donné par @BotFather (https://t.me/BotFather → /newbot).
STOCKWATCH_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chats prévenus même sans /start (ton id perso, un groupe, un canal).
# Envoie /id au bot pour connaître un identifiant. Séparés par des virgules.
STOCKWATCH_CHAT_IDS=

# Si renseigné, seul cet utilisateur peut changer produit / tailles / intervalle.
STOCKWATCH_OWNER_ID=

# --- Ce qu'on surveille ----------------------------------------------------
STOCKWATCH_PRODUCT_URL=https://www.hollisterco.com/shop/eu-fr/p/icon-henley-63586319-2
STOCKWATCH_PRODUCT_LABEL=Hollister — Icon Henley
STOCKWATCH_SIZES=XS,S

# Une fiche produit contient aussi ses autres coloris. Si l'identifiant interne
# du coloris voulu diffère de celui de l'URL, précise-le ici (ou /variante sur
# Telegram). `python -m stockwatch diagnose` liste les identifiants possibles.
STOCKWATCH_PRODUCT_ID=

# Optionnel : endpoint JSON interrogé à la place de la page HTML.
# À n'utiliser que si `python -m stockwatch diagnose --url <endpoint>` le valide.
STOCKWATCH_API_URL=

# --- Cadence ---------------------------------------------------------------
# Une vérification par seconde = alerte "à la seconde". Plancher : 0.2 s.
STOCKWATCH_POLL_INTERVAL=1.0
STOCKWATCH_REQUEST_TIMEOUT=8.0
# Plafond du délai d'attente quand les requêtes échouent en série (secondes).
STOCKWATCH_MAX_BACKOFF=60

# --- Alertes ---------------------------------------------------------------
# Alerter si la taille est déjà dispo à la toute première vérification.
STOCKWATCH_ALERT_ON_FIRST_SEEN=true
# Rappel toutes les N minutes tant que la taille reste dispo (0 = pas de rappel).
STOCKWATCH_REPEAT_ALERT_MINUTES=0
# Nombre d'échecs consécutifs avant de prévenir que la surveillance est dégradée.
STOCKWATCH_ERROR_ALERT_AFTER=12
# Échecs tolérés à cadence normale avant de commencer à ralentir. Utile quand
# le site refuse une requête sur trois : réessayer tout de suite passe souvent.
STOCKWATCH_FAILURE_GRACE=3

# --- Empreinte HTTP (anti-blocage) ----------------------------------------
STOCKWATCH_USER_AGENT=
STOCKWATCH_ACCEPT_LANGUAGE=fr-FR,fr;q=0.9,en;q=0.8
# Colle ici l'en-tête Cookie copié depuis ton navigateur si le site te bloque.
STOCKWATCH_COOKIE=
# En-têtes additionnels, au format JSON. Ex : {"X-Requested-With":"XMLHttpRequest"}
STOCKWATCH_EXTRA_HEADERS=
# Proxy sortant. Ex : http://user:pass@host:port
STOCKWATCH_PROXY_URL=
# HTTP/2 (activé par défaut si le paquet `h2` est installé — il l'est via
# requirements.txt). Le passer à false pour revenir en HTTP/1.1.
STOCKWATCH_HTTP2=true
# Ajoute un paramètre anti-cache à chaque requête (contourne le CDN, plus
# visible, et annule le bénéfice des requêtes conditionnelles ci-dessous).
STOCKWATCH_CACHE_BUSTER=false

# --- Économie de bande passante -------------------------------------------
# Renvoie l'ETag de la dernière réponse : tant que la page n'a pas changé, le
# serveur répond « 304 Not Modified » en quelques centaines d'octets au lieu de
# ~150 Ko. À laisser activé, surtout derrière un proxy facturé au gigaoctet.
STOCKWATCH_CONDITIONAL_REQUESTS=true

# Plafond quotidien de téléchargement, en Mo (0 = illimité). Une fois atteint,
# le bot ralentit tout seul jusqu'à minuit UTC et te prévient une fois.
STOCKWATCH_DAILY_BUDGET_MB=0
# Intervalle appliqué pendant le ralentissement (secondes).
STOCKWATCH_THROTTLED_INTERVAL=300
# Lecture de secours des boutons de taille dans le HTML si aucun JSON n'est lisible.
STOCKWATCH_HTML_FALLBACK=true

# --- Divers ----------------------------------------------------------------
STOCKWATCH_STATE_FILE=stockwatch-state.json
STOCKWATCH_LOG_LEVEL=INFO
